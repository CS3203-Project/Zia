generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id               String        @id @default(cuid())
  serviceId        String
  bookingId        String?
  providerId       String
  userId           String
  gateway          String?       @default("payhere")
  payherePaymentId String?       @unique
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("lkr")
  paidAt           DateTime?
  refundedAt        DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  metadata         Json?
  platformFee      Decimal?      @db.Decimal(10, 2)
  providerAmount   Decimal?      @db.Decimal(10, 2)
  payhereOrderId   String?       @unique
  updatedAt        DateTime      @updatedAt
  status           PaymentStatus @default(PENDING)

  @@index([payhereOrderId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@index([providerId])
  @@index([userId])
}

model ProviderEarnings {
  id               String    @id @default(cuid())
  providerId       String    @unique
  totalEarnings    Decimal   @default(0) @db.Decimal(10, 2)
  availableBalance Decimal   @default(0) @db.Decimal(10, 2)
  pendingBalance   Decimal   @default(0) @db.Decimal(10, 2)
  totalWithdrawn   Decimal   @default(0) @db.Decimal(10, 2)
  currency         String    @default("lkr")
  lastPayoutAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([providerId])
}

/// A customer's request to be refunded for a booking they've already paid for.
///
/// Until now a paid booking had no recovery path at all: it couldn't be
/// cancelled, the refund endpoint was unreachable from any UI, and the only
/// advice was "message the other party". Admins decide these rather than
/// providers, since the provider is the counterparty to the dispute.
model RefundRequest {
  id           String       @id @default(cuid())
  paymentId    String
  bookingId    String?
  /// The customer asking for the refund.
  userId       String
  providerId   String
  amount       Decimal      @db.Decimal(10, 2)
  currency     String       @default("lkr")
  reason       String
  status       RefundStatus @default(PENDING)
  decisionNote String?
  processedBy  String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([paymentId])
}

enum RefundStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A provider's request to withdraw their available balance.
///
/// Until now earnings accumulated with no way out: ProviderEarnings tracked
/// availableBalance and totalWithdrawn, but nothing could ever move money
/// between them. Requesting reserves the amount in pendingBalance so it can't be
/// requested twice while an admin reviews it.
model PayoutRequest {
  id           String       @id @default(cuid())
  providerId   String
  amount       Decimal      @db.Decimal(10, 2)
  currency     String       @default("lkr")
  status       PayoutStatus @default(PENDING)
  /// Where the provider wants the money sent. Free text so this doesn't assume
  /// a particular banking integration.
  payoutMethod String?
  note         String?
  rejectReason String?
  processedBy  String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([providerId, status])
  @@index([status, createdAt])
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Where a provider's payouts are sent.
///
/// Bank details, deliberately not card details: cards are an instrument for
/// taking money, not sending it, and storing a PAN would put this system in
/// PCI-DSS scope for no benefit. Local payouts settle to a bank account.
model PayoutAccount {
  id            String   @id @default(cuid())
  providerId    String   @unique
  accountName   String
  bankName      String
  branch        String?
  /// Stored in full because a payout cannot be made without it. Only ever
  /// returned masked to the provider and to admins - see payoutAccount.service.
  accountNumber String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([providerId])
}
