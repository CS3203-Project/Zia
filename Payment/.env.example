NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zia_core?schema=payment&connection_limit=10&pool_timeout=20
JWT_SECRET=replace_with_strong_secret

# Internal service-to-service auth
INTERNAL_API_KEY=replace_with_internal_service_key
CORE_SERVICE_URL=http://localhost:3000

# Redis (rate limiting)
REDIS_URL=redis://localhost:6379

# PayHere
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=replace_me
PAYHERE_MERCHANT_SECRET=replace_me
PAYHERE_APP_ID=replace_me
PAYHERE_APP_SECRET=replace_me
PAYHERE_RETURN_URL=http://localhost:5173/checkout/success
PAYHERE_CANCEL_URL=http://localhost:5173/checkout/cancel
PAYHERE_NOTIFY_URL=https://your-public-url/api/payments/notify
