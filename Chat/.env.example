NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zia_core?schema=chat&connection_limit=10&pool_timeout=20
JWT_SECRET=replace_with_strong_secret

# RabbitMQ (consumes confirmation.updated events published by core)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis (Socket.IO adapter + shared online-presence store — required for multiple
# Chat replicas to see each other's connected users; without it presence/delivery only
# works within a single pod)
REDIS_URL=redis://localhost:6379

# Internal service-to-service auth (shared with Core/Payment)
INTERNAL_API_KEY=replace_with_internal_service_key
