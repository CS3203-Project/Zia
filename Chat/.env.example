NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zia_core?schema=chat
JWT_SECRET=replace_with_strong_secret

# RabbitMQ (consumes confirmation.updated events published by core)
