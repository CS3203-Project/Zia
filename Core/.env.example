NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zia_core
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=24h

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Internal service-to-service auth (shared with Payment/Chat)
INTERNAL_API_KEY=replace_with_internal_service_key
CHAT_SERVICE_URL=http://localhost:3001

# Google
GOOGLE_MAPS_API_KEY=replace_me

# Gemini embeddings (optional — semantic search falls back to hash-based embeddings without it)
GEMINI_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
