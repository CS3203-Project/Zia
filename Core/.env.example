NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zia_core?connection_limit=10&pool_timeout=20
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=24h

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Redis (rate limiting, geocode cache)
REDIS_URL=redis://localhost:6379

# Internal service-to-service auth (shared with Payment/Chat)
INTERNAL_API_KEY=replace_with_internal_service_key
CHAT_SERVICE_URL=http://localhost:3001

# Object storage (MinIO — talked to via the S3 API, see src/utils/s3.ts)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zia-uploads
MINIO_REGION=us-east-1

# Gemini embeddings (optional — semantic search falls back to hash-based embeddings without it)
GEMINI_API_KEY=
EMBEDDING_API_URL=
EMBEDDING_MODEL=
