# Core API (users, providers, services, categories, admin, schedule, etc.)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_BASE_URL_PROD=https://your-domain.example/api

# Chat API (Socket.IO namespace + REST conversation/message endpoints)
VITE_API_BASE_URL_MESSAGES=http://localhost:3001/messaging
VITE_API_BASE_URL_MESSAGES_PROD=https://your-domain.example/messaging

# Payment API (PayHere checkout/status/history/refund)
# In production this can be the same host as Core — ingress routes /api/payments by path.
VITE_API_BASE_URL_PAYMENTS=http://localhost:3002/api
VITE_API_BASE_URL_PAYMENTS_PROD=https://your-domain.example/api

# Maps
VITE_GOOGLE_MAPS_API_KEY=replace_me
